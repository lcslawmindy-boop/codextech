{
  "name": "Notify Affiliate on Referral Completion",
  "description": "Sends an email to the affiliate whenever a referral is marked completed, including the commission amount earned.",
  "trigger": {
    "condition": "${ ((.trigger.data.status == \"completed\") and (.trigger.data.referrer_email != null and .trigger.data.referrer_email != \"\" and .trigger.data.referrer_email != [] and .trigger.data.referrer_email != {})) }",
    "config": {
      "trigger_type": "entity",
      "events": [
        "create",
        "update"
      ],
      "entity_name": "Referral"
    }
  },
  "definition": {
    "document": {
      "dsl": "1.0.0",
      "name": "notify_affiliate_on_referral_completion",
      "version": "1.0",
      "namespace": "base44"
    },
    "do": [
      {
        "run_function": {
          "call": "invoke_backend_function",
          "with": {
            "function_name": "notifyAffiliateOnReferral",
            "args": {}
          },
          "then": "end"
        }
      }
    ]
  },
  "x-base44-migrated-from-automation": {
    "legacy_payload_function": "notifyAffiliateOnReferral"
  }
}