{
  "name": "NodeExport",
  "type": "object",
  "properties": {
    "node_id": {
      "type": "string",
      "description": "Graph node identifier (e.g. ZRP-NODE-0001)"
    },
    "node_label": {
      "type": "string",
      "description": "Display label of the exported research node"
    },
    "domain": {
      "type": "string",
      "description": "Research domain of the node"
    },
    "researcher": {
      "type": "string",
      "description": "Primary researcher / inventor associated with the node"
    },
    "user_email": {
      "type": "string",
      "description": "Email of the member who exported this PDF"
    },
    "user_name": {
      "type": "string",
      "description": "Full name of the member who exported this PDF"
    },
    "pdf_url": {
      "type": "string",
      "description": "Storage URL of the generated PDF"
    },
    "summary": {
      "type": "string",
      "description": "Short snippet of the AI-generated summary",
      "maxLength": 500
    },
    "patent_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of reference patents included in the export"
    },
    "paper_count": {
      "type": "integer",
      "default": 0,
      "description": "Number of cited research papers included in the export"
    },
    "description": {
      "type": "string",
      "description": "Optional notes about this export",
      "maxLength": 1000
    }
  },
  "required": [
    "node_label",
    "user_email",
    "pdf_url"
  ]
}