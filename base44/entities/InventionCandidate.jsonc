{
  "name": "InventionCandidate",
  "type": "object",
  "properties": {
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project record"
    },
    "name": {
      "type": "string",
      "description": "Invention candidate name"
    },
    "concept_summary": {
      "type": "string",
      "description": "Brief summary of the invention concept",
      "maxLength": 3000
    },
    "technical_description": {
      "type": "string",
      "description": "Detailed technical description"
    },
    "novelty_basis": {
      "type": "string",
      "description": "What makes this invention novel"
    },
    "proposed_mechanism": {
      "type": "string",
      "description": "Proposed operating mechanism"
    },
    "readiness_level": {
      "type": "string",
      "enum": [
        "concept",
        "feasibility",
        "prototype",
        "validated",
        "commercialized"
      ],
      "default": "concept",
      "description": "Technology readiness level"
    },
    "feasibility_summary": {
      "type": "string",
      "description": "Summary of feasibility analysis",
      "maxLength": 3000
    },
    "research_opportunity_id": {
      "type": "string",
      "description": "FK to the ResearchOpportunity this candidate was promoted from"
    },
    "invention_family_id": {
      "type": "string",
      "description": "FK to InventionFamily for grouping related candidates"
    },
    "human_promotion_approved": {
      "type": "boolean",
      "default": false,
      "description": "Whether a human has approved promotion to IPAsset \u2014 only human approval creates an IPAsset"
    },
    "promoted_by_email": {
      "type": "string",
      "description": "Email of the human who approved promotion to IPAsset"
    },
    "promotion_date": {
      "type": "string",
      "description": "ISO date the candidate was promoted to IPAsset"
    },
    "humanitarian_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this candidate has humanitarian application potential"
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "under_evaluation",
        "selected",
        "promoted",
        "archived"
      ],
      "default": "candidate",
      "description": "Evaluation status"
    },
    "related_hybrid_invention_id": {
      "type": "string",
      "description": "Optional cross-reference to an existing HybridInvention record"
    }
  },
  "required": [
    "project_id",
    "name",
    "concept_summary",
    "readiness_level"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}