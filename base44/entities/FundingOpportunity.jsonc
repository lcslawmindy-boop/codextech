{
  "name": "FundingOpportunity",
  "type": "object",
  "properties": {
    "commercialization_case_id": {
      "type": "string",
      "description": "FK to the CommercializationCase this funding supports"
    },
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project for scoping"
    },
    "title": {
      "type": "string",
      "description": "Title of the funding opportunity"
    },
    "funder_name": {
      "type": "string",
      "description": "Name of the funder"
    },
    "funder_type": {
      "type": "string",
      "enum": [
        "grant",
        "investor",
        "strategic_partner",
        "government",
        "foundation",
        "corporate",
        "other"
      ],
      "default": "grant",
      "description": "Type of funder"
    },
    "program_name": {
      "type": "string",
      "description": "Name of the funding program"
    },
    "amount_range_low": {
      "type": "number",
      "description": "Lower bound of funding amount in USD (advisory only)"
    },
    "amount_range_high": {
      "type": "number",
      "description": "Upper bound of funding amount in USD (advisory only)"
    },
    "deadline": {
      "type": "string",
      "description": "ISO date deadline"
    },
    "eligibility_notes": {
      "type": "string",
      "description": "Eligibility requirements",
      "maxLength": 2000
    },
    "url": {
      "type": "string",
      "description": "URL to funding opportunity details"
    },
    "ai_match_score": {
      "type": "integer",
      "description": "AI-estimated match score 0-100 (advisory only, not guaranteed)"
    },
    "ai_match_reasoning": {
      "type": "string",
      "description": "AI reasoning for the match (advisory only, not verified)",
      "maxLength": 2000
    },
    "human_reviewed": {
      "type": "boolean",
      "default": false,
      "description": "Whether a human has reviewed this match"
    },
    "reviewed_by_email": {
      "type": "string",
      "description": "Email of the reviewer"
    },
    "status": {
      "type": "string",
      "enum": [
        "identified",
        "researching",
        "application_draft",
        "submitted",
        "awarded",
        "rejected",
        "withdrawn"
      ],
      "default": "identified",
      "description": "Application status"
    },
    "notes": {
      "type": "string",
      "description": "Additional notes",
      "maxLength": 2000
    }
  },
  "required": [
    "title",
    "funder_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}