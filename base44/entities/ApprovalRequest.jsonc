{
  "name": "ApprovalRequest",
  "type": "object",
  "properties": {
    "entity_type": {
      "type": "string",
      "enum": [
        "project",
        "research_document",
        "evidence_claim",
        "invention_candidate",
        "ip_asset",
        "engineering_artifact"
      ],
      "description": "Which entity type this approval targets"
    },
    "entity_id": {
      "type": "string",
      "description": "ID of the entity being approved"
    },
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project (for scoping and queries)"
    },
    "request_type": {
      "type": "string",
      "enum": [
        "review",
        "publish",
        "file",
        "approve",
        "release",
        "other"
      ],
      "default": "review",
      "description": "Type of approval requested"
    },
    "justification": {
      "type": "string",
      "description": "Why this approval is being requested",
      "maxLength": 2000
    },
    "status": {
      "type": "string",
      "enum": [
        "pending",
        "approved",
        "rejected",
        "withdrawn"
      ],
      "default": "pending",
      "description": "Current approval status"
    },
    "reviewed_by_email": {
      "type": "string",
      "description": "Email of the admin who reviewed"
    },
    "review_notes": {
      "type": "string",
      "description": "Notes from the reviewer",
      "maxLength": 2000
    },
    "reviewed_date": {
      "type": "string",
      "description": "ISO date the request was reviewed"
    },
    "priority": {
      "type": "string",
      "enum": [
        "low",
        "normal",
        "high",
        "urgent"
      ],
      "default": "normal",
      "description": "Priority level"
    }
  },
  "required": [
    "entity_type",
    "entity_id",
    "request_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}