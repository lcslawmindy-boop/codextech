{
  "name": "InventionFamily",
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Name of the invention family"
    },
    "description": {
      "type": "string",
      "description": "Description of the invention family",
      "maxLength": 2000
    },
    "family_type": {
      "type": "string",
      "enum": [
        "technology_family",
        "patent_family",
        "product_family",
        "research_thread"
      ],
      "default": "technology_family",
      "description": "Type of grouping"
    },
    "parent_family_id": {
      "type": "string",
      "description": "FK to parent InventionFamily for nesting"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Searchable tags"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "merged",
        "archived"
      ],
      "default": "active",
      "description": "Family status"
    }
  },
  "required": [
    "name",
    "family_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}