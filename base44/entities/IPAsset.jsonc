{
  "name": "IPAsset",
  "type": "object",
  "properties": {
    "invention_candidate_id": {
      "type": "string",
      "description": "FK to the parent InventionCandidate record (optional if standalone)"
    },
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project record"
    },
    "asset_name": {
      "type": "string",
      "description": "Name of the IP asset"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "patent",
        "trademark",
        "copyright",
        "trade_secret",
        "know_how",
        "design",
        "software_ip",
        "algorithm",
        "dataset",
        "research_method",
        "engineering_design",
        "humanitarian_technology",
        "defensive_publication",
        "archived_concept",
        "other"
      ],
      "default": "patent",
      "description": "Type of intellectual property"
    },
    "description": {
      "type": "string",
      "description": "Brief explanation of what the asset is and how it works (internal)",
      "maxLength": 1000
    },
    "problem_solved": {
      "type": "string",
      "description": "What problem this IP asset solves (internal)",
      "maxLength": 1000
    },
    "target_beneficiaries": {
      "type": "string",
      "description": "Who this asset helps",
      "maxLength": 1000
    },
    "jurisdiction": {
      "type": "string",
      "description": "Filing jurisdiction (e.g., US, EP, PCT)"
    },
    "filing_status": {
      "type": "string",
      "enum": [
        "not_filed",
        "provisional_filed",
        "non_provisional_filed",
        "granted",
        "abandoned"
      ],
      "default": "not_filed",
      "description": "Current filing status"
    },
    "application_number": {
      "type": "string",
      "description": "Patent office application number"
    },
    "filing_date": {
      "type": "string",
      "description": "ISO date filed"
    },
    "grant_date": {
      "type": "string",
      "description": "ISO date granted (if applicable)"
    },
    "valuation_low": {
      "type": "number",
      "description": "Lower bound of estimated IP value in USD (advisory only)"
    },
    "valuation_high": {
      "type": "number",
      "description": "Upper bound of estimated IP value in USD (advisory only)"
    },
    "valuation_basis": {
      "type": "string",
      "description": "Basis for the valuation",
      "maxLength": 500
    },
    "related_patent_claim_id": {
      "type": "string",
      "description": "Optional cross-reference to an existing PatentClaim record"
    },
    "invention_family_id": {
      "type": "string",
      "description": "FK to InventionFamily for grouping related IP assets"
    },
    "ip_strategy": {
      "type": "string",
      "enum": [
        "defensive",
        "offensive",
        "defensive_publication",
        "trade_secret",
        "humanitarian_open",
        "standard"
      ],
      "default": "standard",
      "description": "IP protection strategy"
    },
    "readiness_level": {
      "type": "string",
      "enum": [
        "concept",
        "feasibility",
        "prototype",
        "validated",
        "commercialized"
      ],
      "default": "concept",
      "description": "Technology readiness level (legacy field)"
    },
    "humanitarian_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this IP asset has humanitarian application"
    },
    "humanitarian_category": {
      "type": "string",
      "enum": [
        "clean_water",
        "environmental_monitoring",
        "disaster_response",
        "accessible_communication",
        "assistive_technology",
        "adaptive_learning",
        "energy_efficiency",
        "infrastructure_resilience",
        "safety_technology",
        "investigational_research",
        "none"
      ],
      "default": "none",
      "description": "Humanitarian technology category"
    },
    "confidential": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is confidential"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Human-controlled promotion status"
    },
    "reviewed_by_email": {
      "type": "string",
      "description": "Email of the human reviewer"
    },
    "review_date": {
      "type": "string",
      "description": "ISO date reviewed"
    },
    "evidence_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to EvidenceClaim records"
    },
    "research_document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to ResearchDocument records"
    },
    "engineering_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to EngineeringArtifact records"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "abandoned",
        "sold",
        "archived"
      ],
      "default": "active",
      "description": "Lifecycle status of this IP asset"
    },
    "tech_code": {
      "type": "string",
      "description": "ZDS33 technology ID shown publicly (e.g. ZDS-T-014)"
    },
    "domain_tags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "HUMANITARIAN",
          "DEFENSE_SECURITY",
          "DEEP_SPACE",
          "ASTEROID_MINING",
          "DUAL_USE",
          "MULTI_DOMAIN"
        ]
      },
      "default": [],
      "description": "Mission domain tags. One IP asset can carry several; no duplicate records per portfolio."
    },
    "technology_category": {
      "type": "string",
      "enum": [
        "communications",
        "robotics_autonomy",
        "sensing",
        "power_energy",
        "navigation",
        "materials_handling",
        "infrastructure",
        "medical_support",
        "ai_decision_support",
        "logistics",
        "other"
      ],
      "description": "Technology category for discovery"
    },
    "subsystem": {
      "type": "string",
      "description": "System/subsystem this technology belongs to"
    },
    "development_stage": {
      "type": "string",
      "enum": [
        "concept",
        "research",
        "design",
        "prototype",
        "validation"
      ],
      "default": "concept",
      "description": "Honest development stage. Prototype/validation require stage_evidence."
    },
    "stage_evidence": {
      "type": "string",
      "description": "Evidence on file supporting prototype/validation stage",
      "maxLength": 1500
    },
    "commercialization_readiness": {
      "type": "string",
      "enum": [
        "not_assessed",
        "research_only",
        "developing",
        "partner_ready",
        "transfer_ready"
      ],
      "default": "not_assessed",
      "description": "Commercialization readiness"
    },
    "partnership_pathways": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "ip_broker",
          "licensing",
          "manufacturing_partnership",
          "co_development",
          "research_partnership",
          "strategic_partnership",
          "investment_funding"
        ]
      },
      "default": [],
      "description": "Pathways open for this technology"
    },
    "showcase_status": {
      "type": "string",
      "enum": [
        "hidden",
        "approved_public"
      ],
      "default": "hidden",
      "description": "Only approved_public assets appear in the public showcase, and only their public_* fields"
    },
    "defense_public_review_confirmed": {
      "type": "boolean",
      "default": false,
      "description": "Human confirmation that public fields are high-level and non-operational (required for defense-tagged assets)"
    },
    "public_summary": {
      "type": "string",
      "description": "Approved public summary",
      "maxLength": 1200
    },
    "public_problem": {
      "type": "string",
      "description": "Approved public problem statement",
      "maxLength": 1200
    },
    "public_solution": {
      "type": "string",
      "description": "Approved public high-level solution concept",
      "maxLength": 1200
    },
    "public_capabilities": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Approved public key capabilities"
    },
    "public_applications": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Approved public potential applications"
    },
    "public_gallery": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Approved public image URLs"
    },
    "related_asset_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Related IPAsset ids (cross-domain relationships)"
    }
  },
  "required": [
    "asset_name",
    "asset_type",
    "status"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}