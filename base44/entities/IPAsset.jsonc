{
  "name": "IPAsset",
  "type": "object",
  "properties": {
    "invention_candidate_id": {
      "type": "string",
      "description": "FK to the parent InventionCandidate record (optional if standalone)"
    },
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project record"
    },
    "asset_name": {
      "type": "string",
      "description": "Name of the IP asset"
    },
    "asset_type": {
      "type": "string",
      "enum": [
        "patent",
        "trademark",
        "copyright",
        "trade_secret",
        "know_how",
        "design",
        "software_ip",
        "algorithm",
        "dataset",
        "research_method",
        "engineering_design",
        "humanitarian_technology",
        "defensive_publication",
        "archived_concept",
        "other"
      ],
      "default": "patent",
      "description": "Type of intellectual property"
    },
    "jurisdiction": {
      "type": "string",
      "description": "Filing jurisdiction (e.g., US, EP, PCT)"
    },
    "filing_status": {
      "type": "string",
      "enum": [
        "not_filed",
        "provisional_filed",
        "non_provisional_filed",
        "granted",
        "abandoned"
      ],
      "default": "not_filed",
      "description": "Current filing status"
    },
    "application_number": {
      "type": "string",
      "description": "Patent office application number"
    },
    "filing_date": {
      "type": "string",
      "description": "ISO date filed"
    },
    "grant_date": {
      "type": "string",
      "description": "ISO date granted (if applicable)"
    },
    "valuation_low": {
      "type": "number",
      "description": "Lower bound of estimated IP value in USD (advisory only, not guaranteed)"
    },
    "valuation_high": {
      "type": "number",
      "description": "Upper bound of estimated IP value in USD (advisory only, not guaranteed)"
    },
    "related_patent_claim_id": {
      "type": "string",
      "description": "Optional cross-reference to an existing PatentClaim record"
    },
    "invention_family_id": {
      "type": "string",
      "description": "FK to InventionFamily for grouping related IP assets"
    },
    "ip_strategy": {
      "type": "string",
      "enum": [
        "defensive",
        "offensive",
        "defensive_publication",
        "trade_secret",
        "humanitarian_open",
        "standard"
      ],
      "default": "standard",
      "description": "IP protection strategy"
    },
    "readiness_level": {
      "type": "string",
      "enum": [
        "concept",
        "feasibility",
        "prototype",
        "validated",
        "commercialized"
      ],
      "default": "concept",
      "description": "Technology readiness level"
    },
    "humanitarian_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this IP asset has humanitarian application"
    },
    "humanitarian_category": {
      "type": "string",
      "enum": [
        "clean_water",
        "environmental_monitoring",
        "disaster_response",
        "accessible_communication",
        "assistive_technology",
        "adaptive_learning",
        "energy_efficiency",
        "infrastructure_resilience",
        "safety_technology",
        "investigational_research",
        "none"
      ],
      "default": "none",
      "description": "Humanitarian technology category"
    },
    "confidential": {
      "type": "boolean",
      "default": true,
      "description": "Whether this asset is confidential (restricts external disclosure without human authorization)"
    },
    "review_status": {
      "type": "string",
      "enum": [
        "pending",
        "under_review",
        "approved",
        "rejected"
      ],
      "default": "pending",
      "description": "Human-controlled promotion status \u2014 only human approval promotes InventionCandidate to IPAsset"
    },
    "reviewed_by_email": {
      "type": "string",
      "description": "Email of the human reviewer who approved or rejected this IP asset"
    },
    "review_date": {
      "type": "string",
      "description": "ISO date reviewed"
    },
    "evidence_claim_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to EvidenceClaim records for traceability to supporting evidence"
    },
    "research_document_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to ResearchDocument records for traceability to originating research"
    },
    "engineering_artifact_ids": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "FKs to EngineeringArtifact records for traceability to engineering development"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "under_review",
        "abandoned",
        "sold",
        "archived"
      ],
      "default": "active",
      "description": "Lifecycle status of this IP asset"
    }
  },
  "required": [
    "asset_name",
    "asset_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}