{
  "name": "Organization",
  "type": "object",
  "properties": {
    "organization_name": {
      "type": "string",
      "description": "Name of the organization"
    },
    "organization_type": {
      "type": "string",
      "enum": [
        "private",
        "public",
        "nonprofit",
        "academic",
        "government",
        "research_institution",
        "other"
      ],
      "default": "private",
      "description": "Type of organization"
    },
    "owner_user_id": {
      "type": "string",
      "description": "FK to the User who owns this organization"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "archived"
      ],
      "default": "active",
      "description": "Organization status"
    },
    "default_security_policy": {
      "type": "string",
      "description": "Default security policy for projects under this organization"
    },
    "ai_processing_policy": {
      "type": "string",
      "enum": [
        "enabled",
        "restricted",
        "disabled"
      ],
      "default": "restricted",
      "description": "AI processing policy governing this organization \u2014 restricted means AI may propose but not authorize"
    },
    "retention_policy": {
      "type": "string",
      "description": "Data retention policy"
    }
  },
  "required": [
    "organization_name",
    "organization_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}