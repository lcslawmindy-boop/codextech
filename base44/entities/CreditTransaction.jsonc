{
  "name": "CreditTransaction",
  "type": "object",
  "properties": {
    "user_email": {
      "type": "string",
      "description": "Email of the user who owns these credits"
    },
    "credits": {
      "type": "integer",
      "description": "Credit delta \u2014 positive for purchases/grants, negative for spends"
    },
    "type": {
      "type": "string",
      "enum": [
        "purchase",
        "spend",
        "refund",
        "grant"
      ],
      "default": "purchase"
    },
    "description": {
      "type": "string",
      "description": "What the credits were bought or spent on",
      "maxLength": 500
    },
    "stripe_session_id": {
      "type": "string",
      "description": "Stripe checkout session ID for purchases"
    },
    "pack_name": {
      "type": "string",
      "description": "Name of the credit pack purchased"
    }
  },
  "required": [
    "user_email",
    "credits",
    "type"
  ],
  "rls": {
    "read": {
      "data.user_email": "{{user.email}}"
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}