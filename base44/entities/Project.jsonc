{
  "name": "Project",
  "type": "object",
  "properties": {
    "organization_id": {
      "type": "string",
      "description": "FK to the parent Organization (top-level ownership boundary)"
    },
    "name": {
      "type": "string",
      "description": "Project title"
    },
    "project_code": {
      "type": "string",
      "description": "Unique project code identifier"
    },
    "description": {
      "type": "string",
      "description": "Project summary and scope",
      "maxLength": 2000
    },
    "project_type": {
      "type": "string",
      "enum": [
        "research",
        "product_development",
        "patent_filing",
        "commercialization",
        "general_research",
        "humanitarian_rd",
        "ip_development",
        "engineering",
        "historical_research",
        "other"
      ],
      "default": "research",
      "description": "Category of project (legacy values retained for backward compatibility)"
    },
    "program_type": {
      "type": "string",
      "enum": [
        "general_research",
        "humanitarian_rd",
        "ip_development",
        "engineering",
        "commercialization",
        "historical_research"
      ],
      "description": "Program type classification per ZARP v2.0 data model"
    },
    "research_domain": {
      "type": "string",
      "description": "Research domain or technical field (e.g., RF Systems, Bioelectromagnetics)"
    },
    "project_owner": {
      "type": "string",
      "description": "Email or ID of the project owner"
    },
    "confidentiality_level": {
      "type": "string",
      "enum": [
        "public",
        "internal",
        "confidential",
        "restricted"
      ],
      "default": "confidential",
      "description": "Security classification level"
    },
    "lifecycle_stage": {
      "type": "string",
      "enum": [
        "research",
        "evidence",
        "opportunity",
        "invention",
        "feasibility",
        "ip_asset",
        "rd",
        "validation",
        "ip_strategy",
        "funding",
        "partnership",
        "commercialization"
      ],
      "description": "Current stage in the north-star lifecycle"
    },
    "humanitarian_flag": {
      "type": "boolean",
      "default": false,
      "description": "Whether this project has humanitarian application"
    },
    "status": {
      "type": "string",
      "enum": [
        "planning",
        "active",
        "paused",
        "completed",
        "archived"
      ],
      "default": "planning",
      "description": "Current project status"
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Searchable tags for this project"
    },
    "start_date": {
      "type": "string",
      "description": "ISO date the project started"
    },
    "target_end_date": {
      "type": "string",
      "description": "ISO date for target completion"
    },
    "completed_date": {
      "type": "string",
      "description": "ISO date the project was completed"
    },
    "archived_at": {
      "type": "string",
      "description": "ISO date the project was archived"
    },
    "related_hybrid_invention_id": {
      "type": "string",
      "description": "Optional cross-reference to an existing HybridInvention record"
    },
    "related_research_experiment_id": {
      "type": "string",
      "description": "Optional cross-reference to an existing ResearchExperiment record"
    }
  },
  "required": [
    "name",
    "project_type",
    "status"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}