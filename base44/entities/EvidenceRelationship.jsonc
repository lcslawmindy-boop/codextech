{
  "name": "EvidenceRelationship",
  "type": "object",
  "properties": {
    "evidence_claim_id": {
      "type": "string",
      "description": "FK to the primary EvidenceClaim record"
    },
    "related_evidence_claim_id": {
      "type": "string",
      "description": "FK to the related EvidenceClaim record"
    },
    "relationship_type": {
      "type": "string",
      "enum": [
        "supports",
        "contradicts",
        "extends",
        "refines",
        "supersedes",
        "cites",
        "other"
      ],
      "default": "supports",
      "description": "How the related claim relates to the primary claim"
    },
    "description": {
      "type": "string",
      "description": "Description of the relationship between the two claims",
      "maxLength": 2000
    },
    "strength": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak"
      ],
      "default": "moderate",
      "description": "Strength of the relationship"
    }
  },
  "required": [
    "evidence_claim_id",
    "related_evidence_claim_id",
    "relationship_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}