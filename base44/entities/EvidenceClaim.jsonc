{
  "name": "EvidenceClaim",
  "type": "object",
  "properties": {
    "research_document_id": {
      "type": "string",
      "description": "FK to the parent ResearchDocument record"
    },
    "project_id": {
      "type": "string",
      "description": "FK to the parent Project (denormalized for scoping)"
    },
    "claim_text": {
      "type": "string",
      "description": "The evidence claim statement",
      "maxLength": 3000
    },
    "claim_type": {
      "type": "string",
      "enum": [
        "experimental",
        "theoretical",
        "observational",
        "meta_analysis",
        "simulation",
        "other"
      ],
      "default": "experimental",
      "description": "Nature of the evidence"
    },
    "evidence_strength": {
      "type": "string",
      "enum": [
        "strong",
        "moderate",
        "weak",
        "speculative"
      ],
      "default": "moderate",
      "description": "Assessed strength of the evidence"
    },
    "supporting_data": {
      "type": "string",
      "description": "Description of supporting data or measurements"
    },
    "citations": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "default": [],
      "description": "Reference citations for this claim"
    },
    "status": {
      "type": "string",
      "enum": [
        "proposed",
        "verified",
        "disputed",
        "refuted"
      ],
      "default": "proposed",
      "description": "Verification status of the claim"
    }
  },
  "required": [
    "research_document_id",
    "claim_text",
    "claim_type"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "delete": {
      "$or": [
        {
          "created_by_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    }
  }
}